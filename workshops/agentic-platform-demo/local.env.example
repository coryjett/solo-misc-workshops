# Copy to local.env (gitignored) and fill in. Sourced by env.sh.
# Solo Enterprise license: a file containing the key (or KEY=value). Required.
LICENSE_SOURCE=/path/to/solo-license.txt
# Self-hosted, OpenAI-compatible model used by the "auto" virtual model (LLM modules).
export LOCAL_LLM_BASE_URL=https://your-model-endpoint/v1
export LOCAL_LLM_MODEL=default
# Key for that endpoint: export LOCAL_LLM_KEY directly, or name a macOS Keychain item.
# export LOCAL_LLM_KEY=...
export LOCAL_LLM_KEYCHAIN_SERVICE=
# File containing OPENAI_API_KEY=... for the hosted model (or export OPENAI_API_KEY).
export OPENAI_ENV_FILE=
