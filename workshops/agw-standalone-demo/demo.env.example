# Copy to demo.env (gitignored) and fill in. Sourced by env.sh.

# Self-hosted, OpenAI-compatible model (required)
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=llama3.2
#LOCAL_LLM_KEY=
#LOCAL_LLM_KEYCHAIN=            # macOS only: Keychain service name holding the key

# OpenAI key for the premium model, cloud fallback and the AI judge (one of these)
#OPENAI_API_KEY=
#OPENAI_ENV_FILE=/path/to/.env  # a file containing OPENAI_API_KEY=...

# Solo license (one of these; or LICENSE_SOURCE=<path> in ./.license-source)
#SOLO_LICENSE_KEY=
#LICENSE_SOURCE=/path/to/license.txt

# Optional
#COMPANY=Acme
#JUDGE=openai                   # or local
